{
    "compilerOptions": {
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0",
        "lib": [
            "dom",
            "es2015"
        ],
        "moduleResolution": "node",
        "outDir": "./build",
        "rootDir": "./src",
        "strict": false,
        "target": "es2015"
    },
    "include": [
        "src/**/*.ts",
        "src/custom-elements.js"
    ],
    "exclude": [
        "src/tippy.js"
    ]
}